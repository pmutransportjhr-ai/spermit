   <style type="text/css">
        .page-header .page-header-top .page-logo .logo-default {
            margin: 3px 10px 0 !important;
        }

        .form-horizontal .control-label {
            text-align: left !important;
        }
         .page-breadcrumb {
           text-transform: uppercase;
       }
          .title-center {text-align: center;}
        .title-center1{font-size: 24px;font-weight: bold;color: #54A624;}
        .title-center2{font-size: 22px;font-weight: bold;color: #006EBD;}
        .title-center3{font-size: 14px;font-weight: bold;color: #54A624;}
    </style>
       <noscript>
    <meta http-equiv="Refresh" content="0;URL=noJavascript.html" />
        </noscript>
</head>
<body class="page-container-bg-solid page-boxed">
    <div id="Loader">
        <div class="waiting-text">
            <h4>
                <img src="assets/global/img/loading-spinner-blue.gif" alt="" />&nbsp;&nbsp;Please wait. Processing request...</h4>
        </div>
    </div>
    <div class="page-header">
        <!-- BEGIN HEADER TOP -->
        <div class="page-header-top">
            <div class="container">
                <!-- BEGIN LOGO -->
                <div class="page-logo">
                    <a href="#">
                        <img src="assets/img/logo.png" alt="logo" class="logo-default" />
                    </a>

                </div>
                <!-- END LOGO -->
                <!-- BEGIN RESPONSIVE MENU TOGGLER -->
                <a href="javascript:;" class="menu-toggler"></a>
                <!-- END RESPONSIVE MENU TOGGLER -->
                <!-- BEGIN TOP NAVIGATION MENU -->
                <div class="top-menu">
                    <ul class="nav navbar-nav pull-right">

                        <li style="text-align: center; padding-right:120px">
                             <span class="title-center1">Government of Jharkhand</span>
                    <br /><span class="title-center2">Transport Department</span>
                    <br /><span class="title-center3">Online State Permit System</span>
                        </li>

                        <!-- BEGIN USER LOGIN DROPDOWN -->
                        <li>
                            <div id="username" runat="server" class="username username-hide-mobile"></div><div><a href="LogOut.aspx">Log Out</a>
                           </div><div><a href="RTA-CHANGE-PASSWORD.aspx">Change Password</a></div>

                        </li>

                        <!-- END USER LOGIN DROPDOWN -->
                        <!-- BEGIN QUICK SIDEBAR TOGGLER -->

                        <!-- END QUICK SIDEBAR TOGGLER -->
                    </ul>
                </div>
                <!-- END TOP NAVIGATION MENU -->
            </div>
        </div>
        <!-- END HEADER TOP -->
        <!-- BEGIN HEADER MENU -->
        <div class="page-header-menu">
            <div class="container">

                <!-- BEGIN MEGA MENU -->
                <!-- DOC: Apply "hor-menu-light" class after the "hor-menu" class below to have a horizontal menu with white background -->
                <!-- DOC: Remove data-hover="dropdown" and data-close-others="true" attributes below to disable the dropdown opening on mouse hover -->
                <div class="hor-menu  ">

                    <ul id="ulMenu" runat="server" class="nav navbar-nav">
                        
                    </ul>
                </div>
                <!-- END MEGA MENU -->
            </div>
        </div>
        <!-- END HEADER MENU -->
    </div>
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
    </asp:ContentPlaceHolder>
    <div class="page-footer">
        <div class="container">
            All Rights Reserved by Government of Jharkhand, India.
                
        </div>
    </div>
    <div class="scroll-to-top">
        <i class="icon-arrow-up"></i>
    </div>
    <div id="loadingmessage" class="modal fade" tabindex="-1" data-backdrop="static" style="top: 40%; " data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content" style="left:40%;width:200px;border:3px solid #999">
                <div class="modal-body" style="padding: 0px 0px 0px 10px;">
                    <img id="loading" src="assets/global/img/loading-spinner-blue.gif" style="padding: 10px 0 10px 10px; z-index: 10600" alt="loading.........." /><span style="font-size:16px"><b> Please Wait.....</b></span>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="RegDetail" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    
                  
                  <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                        <h4 class="modal-title"><b>History of Registration Number</b></h4>
                        <br />
                    </div>
                    <div class="modal-body" style=" height: 350px !important;overflow-y:auto !important; overflow-x:auto !important">
                            <div class="row">
                            <div id="DivHistory" runat="server"></div>
                        </div>
                            
                  </div>
                   <div class="modal-footer">
                        <button type="button" class="btn dark btn-outline" data-dismiss="modal">CLOSE</button>
                    </div>
            
                <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
        </div></div>
    <div class="modal fade" id="RegComments" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    
                  
                  <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                        <h4 class="modal-title"><b>Comments</b></h4>
                        <br />
                    </div>
                    <div class="modal-body" style=" height: 350px !important;overflow-y:auto !important; overflow-x:auto !important">
                            <div class="row">
                            <div class="col-md-12">
                                <p id="Commentsdetail" runat="server" ></p>
                            </div>
                        </div>
                            
                  </div>
                   <div class="modal-footer">
                        <button id="btnComm" data-dismiss="modal" type="button" class="btn dark btn-outline">CLOSE</button>
                    </div>
                
                <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
        </div></div>
