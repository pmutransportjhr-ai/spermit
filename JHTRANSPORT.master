    <!-- BEGIN THEME LAYOUT SCRIPTS -->
    <script src="assets/layouts/layout3/scripts/layout.min.js" type="text/javascript"></script>
    <script src="assets/layouts/layout3/scripts/demo.min.js" type="text/javascript"></script>
    <script src="assets/layouts/global/scripts/quick-sidebar.min.js" type="text/javascript"></script>
    <!-- END THEME LAYOUT SCRIPTS -->

    <script type="text/javascript">
        // Global Toggle Function for Mobile Menu
        function toggleMenu() {
            $(".main-menu").toggleClass("menu-open");
        }

        // Global Helper to Dismiss Loaders & Overlays
        function hideAllLoaders() {
            $("#Loader").fadeOut("fast");
            if ($("#loadingmessage").length) {
                try { $("#loadingmessage").modal("hide"); } catch (err) {}
                $("#loadingmessage").removeClass("in").removeClass("show").css("display", "none").attr("aria-hidden", "true");
            }
            $(".modal-backdrop").remove();
            $("body").removeClass("modal-open").css("padding-right", "").css("overflow", "");
        }

        // Attach ASP.NET AJAX EndRequestHandler globally
        function attachPrmEndRequestHandler() {
            if (typeof (Sys) !== 'undefined' && typeof (Sys.WebForms) !== 'undefined' && typeof (Sys.WebForms.PageRequestManager) !== 'undefined') {
                var prm = Sys.WebForms.PageRequestManager.getInstance();
                if (prm && !prm._endReqAttached) {
                    prm._endReqAttached = true;
                    prm.add_endRequest(function (sender, args) {
                        hideAllLoaders();
                        setTimeout(hideAllLoaders, 150);
                        setTimeout(hideAllLoaders, 400);
                    });
                    prm.add_asyncPostBackError(function (sender, args) {
                        hideAllLoaders();
                    });
                }
            }
        }

        $(document).ajaxComplete(function () { hideAllLoaders(); });
        $(document).ajaxError(function () { hideAllLoaders(); });

        $(document).ready(function () {
            hideAllLoaders();
            attachPrmEndRequestHandler();

            // Handle Submenu Clicks for Mobile
            $(document).on('click', '.main-menu li > a', function (e) {
                var $parent = $(this).parent();
                var $submenu = $parent.children('ul');

                if ($submenu.length > 0 && $(window).width() < 992) {
                    e.preventDefault();
                    e.stopPropagation();

                    $parent.siblings().removeClass('open');
                    $parent.toggleClass('open');
                }
            });

            // Close menu when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.custom-header-menu').length) {
                    $('.main-menu').removeClass('menu-open');
                    $('.main-menu li').removeClass('open');
                }
            });

            // Reset menu state on window resize
            $(window).resize(function () {
                if ($(window).width() > 991) {
                    $('.main-menu').removeClass('menu-open').css("display", "");
                    $('.main-menu li').removeClass('open');
                }
            });
        });

        $(window).on('load', function () {
            hideAllLoaders();
            attachPrmEndRequestHandler();
        });

        if (typeof (Sys) !== 'undefined' && typeof (Sys.Application) !== 'undefined') {
            Sys.Application.add_load(function () {
                hideAllLoaders();
                attachPrmEndRequestHandler();
            });
        }
    </script>

</body>
</html>
