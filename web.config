<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <appSettings>
    <add key="PrefixKey" value="Jht_" />
    <add key="SecurityKey" value="JhTransport" />
  </appSettings>
  <connectionStrings>
    <add name="connectionstring" connectionString="Server=(LocalDB)\MSSQLLocalDB;Database=JHT_LIVE;Trusted_Connection=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <compilation debug="false" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Web.Extensions.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Transactions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Net.Http, Version=4.2.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="PresentationCore, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="PresentationFramework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="WindowsBase, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <authorization>
      <allow verbs="Get" users="*" />
      <allow verbs="Post" users="*" />
      <deny verbs="OPTIONS" users="*" />
      <deny verbs="TRACE" users="*" />
      <deny verbs="HEAD" users="*" />
      <deny verbs="MOVE" users="*" />
      <deny verbs="DELETE" users="*" />
    </authorization>
    <!--  <authorization>
      <allow users="*"/>
    </authorization> -->
    <webServices>
      <protocols>
        <add name="HttpGet" />
        <add name="HttpPost" />
      </protocols>
    </webServices>
    <trace enabled="false" />
   
	  <httpCookies httpOnlyCookies="true" requireSSL="true" />
    <sessionState mode="InProc" regenerateExpiredSessionId="true" timeout="30" />
    <!--<customErrors mode="On">
      <error statusCode="404" redirect="~/errorPage.html" />
    </customErrors>-->
	<customErrors mode="On" defaultRedirect="errorPage.html" />
	  <!-- <customErrors mode="Off" /> -->
	  <httpRuntime maxRequestLength="500000" executionTimeout="3600" enableVersionHeader="false" requestLengthDiskThreshold="100000" />
    <identity impersonate="true" />
	  <authentication mode="Forms" />
	  <pages
	  enableViewStateMac="true"
	  viewStateEncryptionMode="Always"
	  controlRenderingCompatibilityVersion="4.0" />
	  <machineKey
	validationKey="AutoGenerate"
	decryptionKey="AutoGenerate"
	validation="HMACSHA256"
	decryption="AES" />
    <!-- new line added 
    <machineKey validationKey="A130E240DF1C49E2764EF8A86CEDCBB11274E5298A130CA08B90EED016C014CEAE1D86344C29E67E99DF83347E43820050A2B9C9FC89E0574BF3394B6D0401A9" decryptionKey="2CC37FFA8D14925B9CBCC0E3B1506F35066FEF33FEB4ADC8" validation="SHA1 " />-->
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Server" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <clear />
      <error statusCode="404" path="../errorPage.html" responseMode="Redirect" />
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="403" subStatusCode="-1" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="404" path="errorPage.html" responseMode="File" />
      <error statusCode="500" path="errorPage.html" responseMode="File" />
      <error statusCode="403" path="errorPage.html" responseMode="File" />
    </httpErrors>
    <!--<httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough">
      <clear />
    </httpErrors>-->
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <add value="PermitHomePage.aspx" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering removeServerHeader="true">
        <fileExtensions>
          <remove fileExtension=".csproj" />
          <remove fileExtension=".cs" />
          <remove fileExtension=".config" />
          <remove fileExtension=".master" />
          <remove fileExtension=".asax" />
        </fileExtensions>
      </requestFiltering>
      <authorization>
        <remove users="*" roles="" verbs="" />
        <add accessType="Allow" users="*" />
      </authorization>
    </security>
    <!--<directoryBrowse enabled="true"/>


  
  
     <validation validateIntegratedModeConfiguration="false"/>-->
    <!--<rewrite>
            <outboundRules>
                <rule name="Remove Server" enabled="false">
                    <match serverVariable="RESPONSE_SERVER" pattern="*" />
                    <action type="Rewrite" />
                </rule>
            </outboundRules>
        </rewrite>-->
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="itextsharp" publicKeyToken="8354ae6d2174ddca" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.4.0" newVersion="4.0.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>