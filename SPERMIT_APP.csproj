<Project ToolsVersion="15.0" DefaultTargets="Build"
xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <ProjectGuid>{D1A3E9F4-5A2B-4B7C-9E3A-1234567890AB}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SPERMIT_APP</RootNamespace>
    <AssemblyName>SPERMIT_APP</AssemblyName>
    <UseIISExpress>true</UseIISExpress>
    <IISExpressAnonymousAuthentication>true</IISExpressAnonymousAuthentication>
    <IISExpressWindowsAuthentication>false</IISExpressWindowsAuthentication>
    <IISExpressUseClassicPipelineMode>false</IISExpressUseClassicPipelineMode>
  </PropertyGroup>

  <!-- Compile all C# source code -->
  <ItemGroup>
    <Compile Include="**\*.cs" />
    <Compile Include="**\*.designer.cs" />
  </ItemGroup>

  <!-- ASPX, ASCX, Master Pages, JS, CSS, HTML -->
  <ItemGroup>
    <Content Include="**\*.aspx" />
