    <Reference Include="itextsharp.xmlworker">
      <HintPath>Bin\itextsharp.xmlworker.dll</HintPath>
    </Reference>
    <Reference Include="ncmcaptcha">
      <HintPath>Bin\ncmcaptcha.dll</HintPath>
    </Reference>
